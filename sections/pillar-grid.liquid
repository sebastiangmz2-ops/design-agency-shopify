<div class="pillar-grid" id="pillar-grid">
  <a href="{{ pages['coastal'].url | default: '/pages/coastal' }}" class="pillar-grid__tile">
    <img src="{{ 'coastal-pillar-living-room.jpg' | asset_url }}" alt="Coastal" loading="lazy" width="1200" height="800">
    <span class="pillar-grid__label">Coastal</span>
  </a>
  <a href="{{ pages['modern-farm'].url | default: '/pages/modern-farm' }}" class="pillar-grid__tile">
    <img src="{{ 'pillar-modern-farm.jpg' | asset_url }}" alt="Modern Farm" loading="lazy" width="1200" height="800">
    <span class="pillar-grid__label">Modern Farm</span>
  </a>
  <a href="{{ pages['minimal'].url | default: '/pages/minimal' }}" class="pillar-grid__tile">
    <img src="{{ 'pillar-minimal.jpg' | asset_url }}" alt="Minimal" loading="lazy" width="1200" height="800">
    <span class="pillar-grid__label">Minimal</span>
  </a>
  <a href="{{ pages['heritage'].url | default: '/pages/heritage' }}" class="pillar-grid__tile">
    <img src="{{ 'pillar-heritage.jpg' | asset_url }}" alt="Heritage" loading="lazy" width="1200" height="800">
    <span class="pillar-grid__label">Heritage</span>
  </a>
  <a href="{{ pages['sanctuary'].url | default: '/pages/sanctuary' }}" class="pillar-grid__tile">
    <img src="{{ 'pillar-sanctuary.jpg' | asset_url }}" alt="Sanctuary" loading="lazy" width="1200" height="800">
    <span class="pillar-grid__label">Sanctuary</span>
  </a>
</div>

{% stylesheet %}
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 2rem var(--page-margin, 16px) 4rem;
    background: #ffffff;
  }

  @media screen and (max-width: 989px) {
    .pillar-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }

  .pillar-grid__tile {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    text-decoration: none;
  }

  .pillar-grid__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pillar-grid__tile:hover img {
    transform: scale(1.03);
  }

  .pillar-grid__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "optima-lt-pro", var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.65);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pillar grid",
  "presets": [
    { "name": "Pillar grid" }
  ]
}
{% endschema %}
