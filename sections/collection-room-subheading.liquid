<div class="collection-room-subheading">
  <h1 class="collection-room-subheading__pillar">{{ section.settings.pillar_name }}</h1>
  <div class="collection-room-subheading__rule"></div>

  {% if section.blocks.size > 0 %}
    <nav class="collection-room-subheading__rooms-nav" aria-label="Shop by room">
      {% for block in section.blocks %}
        {% liquid
          assign is_current = false
          if block.settings.link == request.path
            assign is_current = true
          endif
        %}
        <a
          href="{{ block.settings.link }}"
          class="collection-room-subheading__room-link{% if is_current %} collection-room-subheading__room-link--current{% endif %}"
          {% if is_current %}aria-current="page"{% endif %}
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </a>
      {% endfor %}
    </nav>
  {% endif %}
</div>

{% stylesheet %}
  .collection-room-subheading {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem var(--page-margin, 16px) 2rem;
    background: #ffffff;
  }

  .collection-room-subheading__pillar {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    color: #000000;
  }

  .collection-room-subheading__rule {
    width: 100%;
    max-width: var(--page-content-width, 1400px);
    border-top: 1px solid #000000;
    margin: 1.25rem 0;
  }

  .collection-room-subheading__rooms-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.75rem;
    max-width: var(--page-content-width, 1400px);
  }

  .collection-room-subheading__room-link {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.4);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition: color 0.25s ease, border-color 0.25s ease, text-shadow 0.25s ease;
  }

  .collection-room-subheading__room-link:hover,
  .collection-room-subheading__room-link:focus-visible {
    color: #000000;
    border-bottom-color: #000000;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.35);
  }

  .collection-room-subheading__room-link--current {
    color: #000000;
    font-weight: 600;
    border-bottom-color: #000000;
    pointer-events: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Room subheading",
  "settings": [
    {
      "type": "text",
      "id": "pillar_name",
      "label": "Pillar name",
      "default": "Pillar"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Collection title (for room name)"
    }
  ],
  "blocks": [
    {
      "type": "room_link",
      "name": "Room link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Room name",
          "default": "Room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Room subheading" }
  ]
}
{% endschema %}
