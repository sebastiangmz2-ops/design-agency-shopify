{% liquid
  assign display_title = section.settings.title | remove: 'Modern Farm ' | remove: 'Coastal ' | remove: 'Minimal ' | remove: 'Heritage '
%}

<div class="collection-room-subheading">
  <h2>{{ display_title }}</h2>
</div>

{% stylesheet %}
  .collection-room-subheading {
    text-align: center;
    padding: 2.5rem var(--page-margin, 16px) 0.5rem;
    background: #ffffff;
  }

  .collection-room-subheading h2 {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    color: #000000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Room subheading",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
  ],
  "presets": [
    { "name": "Room subheading" }
  ]
}
{% endschema %}
