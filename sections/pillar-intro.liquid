<div class="pillar-intro">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400', class: 'pillar-intro__image' }}
  {% elsif section.settings.fallback_image_filename != blank %}
    <img
      class="pillar-intro__image"
      src="{{ section.settings.fallback_image_filename | asset_url }}"
      alt="The Design Agency"
      loading="eager"
      width="2000"
      height="1312"
    >
  {% endif %}

  <div class="pillar-intro__content">
    <p class="pillar-intro__eyebrow">The Design Agency Presents</p>
    <h1 class="pillar-intro__headline">Inspiration Delivered</h1>
    <p class="pillar-intro__body">
      Distinct points of view on home, curated by Melissa Bilicki,
      Principal Designer of The Design Agency.
    </p>
    <a href="#pillar-grid" class="pillar-intro__cta">Explore the Collections</a>
  </div>
</div>

{% stylesheet %}
  .pillar-intro {
    position: relative;
    min-height: 90vh;
    overflow: hidden;
    background: #000000;
  }

  .pillar-intro__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pillar-intro__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    gap: 1.25rem;
    min-height: 90vh;
    max-width: 26rem;
    padding: 12vh clamp(1.5rem, 5vw, 5rem) 3rem;
    color: #ffffff;
  }

  .pillar-intro__eyebrow {
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .pillar-intro__headline {
    font-family: "optima-lt-pro", var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1.1;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.55);
  }

  .pillar-intro__body {
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .pillar-intro__cta {
    margin-top: 0.5rem;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    border-bottom: 1px solid #ffffff;
    padding-bottom: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pillar intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_image_filename",
      "label": "Fallback theme asset filename"
    }
  ],
  "presets": [
    { "name": "Pillar intro" }
  ]
}
{% endschema %}
