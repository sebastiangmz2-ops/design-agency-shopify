{% liquid
  assign display_title = section.settings.title | remove: 'Modern Farm ' | remove: 'Coastal ' | remove: 'Minimal ' | remove: 'Heritage '
%}

<div class="pillar-header" id="{{ section.settings.title | handleize }}">
  <div class="pillar-header__image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400' }}
    {% elsif section.settings.fallback_image_filename != blank %}
      <img
        src="{{ section.settings.fallback_image_filename | asset_url }}"
        alt="{{ section.settings.title }}"
        loading="eager"
        width="2400"
        height="1600"
      >
    {% endif %}
    {% unless section.settings.hide_title %}
      <a href="{{ routes.root_url }}" class="pillar-header__back-link">&larr; All Home Styles</a>
      <h1 class="pillar-header__title">{{ display_title }}</h1>
    {% endunless %}
  </div>

  {% if section.blocks.size > 0 %}
    {% if section.settings.nav_heading != blank %}
      <div class="pillar-header__nav-heading-wrap">
        <h2 class="pillar-header__nav-heading">{{ section.settings.nav_heading }}</h2>
        <div class="pillar-header__nav-rule"></div>
      </div>
    {% endif %}
    <nav class="pillar-header__rooms-nav" aria-label="Shop by room">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="pillar-header__room-link" {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </a>
      {% endfor %}
    </nav>
  {% endif %}
</div>

{% stylesheet %}
  .pillar-header {
    background: #ffffff;
    color: #000000;
    padding-top: 4rem;
    padding-bottom: 1.5rem;
  }

  .pillar-header__back-link {
    position: absolute;
    top: 1.75rem;
    left: var(--page-margin, 16px);
    z-index: 1;
    font-family: var(--font-body--family);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85), 0 2px 8px rgba(0, 0, 0, 0.6);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .pillar-header__back-link:hover,
  .pillar-header__back-link:focus-visible {
    color: #ffffff;
    border-bottom-color: #ffffff;
  }

  .pillar-header__title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: 100%;
    text-align: center;
    font-family: "optima-lt-pro", var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.5vw, 4.8rem);
    line-height: 1.05;
    color: #ffffff;
    text-transform: uppercase;
    text-shadow: 0 4px 10px rgba(0, 0, 0, 0.65);
  }

  .pillar-header__image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f2f2f2;
  }

  .pillar-header__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pillar-header__nav-heading-wrap {
    padding: 3rem var(--page-margin, 16px) 0;
    max-width: var(--page-content-width, 1400px);
    margin: 0 auto;
  }

  .pillar-header__nav-heading {
    margin: 0;
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: #000000;
  }

  .pillar-header__nav-rule {
    border-top: 1px solid #000000;
    margin-top: 1.5rem;
  }

  .pillar-header__rooms-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.75rem;
    padding: 2rem var(--page-margin, 16px) 0;
  }

  .pillar-header__room-link {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .pillar-header__room-link:hover {
    border-bottom-color: #000000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pillar header",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Pillar"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    },
    {
      "type": "text",
      "id": "fallback_image_filename",
      "label": "Fallback theme asset filename",
      "info": "Used until a Header image is picked above, e.g. pillar-coastal.jpg"
    },
    {
      "type": "checkbox",
      "id": "hide_title",
      "label": "Hide title overlay on image",
      "default": false
    },
    {
      "type": "text",
      "id": "nav_heading",
      "label": "Room nav heading",
      "info": "Shown above the room links, e.g. \"Explore Melissa's Curated Collection\""
    }
  ],
  "blocks": [
    {
      "type": "room_link",
      "name": "Room link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Room name",
          "default": "Room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillar header"
    }
  ]
}
{% endschema %}
