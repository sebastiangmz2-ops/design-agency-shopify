<div class="coastal-pillar">
  <div class="coastal-pillar__intro page-width-narrow">
    <h1 class="coastal-pillar__title">{{ section.settings.title | default: 'Coastal Pillar' }}</h1>
    <p class="coastal-pillar__subtitle">{{ section.settings.subtitle | default: 'Santa Barbara Beach House' }}</p>
  </div>

  <div class="coastal-pillar__header-image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400' }}
    {% else %}
      <img
        src="{{ 'coastal-pillar-living-room.jpg' | asset_url }}"
        alt="{{ section.settings.title | default: 'Coastal Pillar' }}"
        loading="eager"
        width="2400"
        height="1600"
      >
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .coastal-pillar {
    background: #ffffff;
    color: #000000;
    padding-block: 4rem;
  }

  .coastal-pillar__intro {
    margin-inline: auto;
    text-align: center;
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 3rem;
  }

  .coastal-pillar__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    margin: 0 0 0.75rem;
    color: #000000;
  }

  .coastal-pillar__subtitle {
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .coastal-pillar__header-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .coastal-pillar__header-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coastal Pillar",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Coastal Pillar"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Santa Barbara Beach House"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    }
  ],
  "presets": [
    {
      "name": "Coastal Pillar"
    }
  ]
}
{% endschema %}
