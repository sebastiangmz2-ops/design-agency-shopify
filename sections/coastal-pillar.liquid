<div class="coastal-pillar">
  <div class="coastal-pillar__intro page-width-narrow">
    <h1 class="coastal-pillar__title">{{ section.settings.title | default: 'Coastal' }}</h1>
  </div>

  <div class="coastal-pillar__header-image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2000,2400' }}
    {% else %}
      <img
        src="{{ 'coastal-pillar-living-room.jpg' | asset_url }}"
        alt="{{ section.settings.title | default: 'Coastal' }}"
        loading="eager"
        width="2400"
        height="1600"
      >
    {% endif %}
  </div>

  <nav class="coastal-pillar__rooms-nav" aria-label="Shop by room">
    <a href="{{ routes.collections_url }}/primary-bedroom" class="coastal-pillar__room-link">Primary Bedroom</a>
    <a href="{{ routes.collections_url }}/living-room" class="coastal-pillar__room-link">Living Room</a>
    <a href="{{ routes.collections_url }}/dining-room" class="coastal-pillar__room-link">Dining Room</a>
    <a href="{{ routes.collections_url }}/guest-bedroom" class="coastal-pillar__room-link">Guest Bedroom</a>
    <a href="{{ routes.collections_url }}/office" class="coastal-pillar__room-link">Office</a>
    <a href="{{ routes.collections_url }}/powder-bathroom" class="coastal-pillar__room-link">Powder Bathroom</a>
    <a href="{{ routes.collections_url }}/outdoors" class="coastal-pillar__room-link">Outdoors</a>
  </nav>
</div>

{% stylesheet %}
  .coastal-pillar {
    background: #ffffff;
    color: #000000;
    padding-block: 4rem;
  }

  .coastal-pillar__intro {
    margin-inline: auto;
    text-align: center;
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 3rem;
  }

  .coastal-pillar__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    margin: 0 0 0.75rem;
    color: #000000;
    text-transform: uppercase;
  }

  .coastal-pillar__header-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .coastal-pillar__header-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .coastal-pillar__rooms-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.75rem;
    padding: 2.5rem var(--page-margin, 16px) 0;
  }

  .coastal-pillar__room-link {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }

  .coastal-pillar__room-link:hover {
    border-bottom-color: #000000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coastal Pillar",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Coastal"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    }
  ],
  "presets": [
    {
      "name": "Coastal Pillar"
    }
  ]
}
{% endschema %}
