<div class="pillar-explore-cta">
  <a href="{{ section.settings.link | default: '#pillar-grid' }}" class="pillar-explore-cta__label">
    {{ section.settings.label | default: 'Explore the Collections' }}
  </a>
  <div class="pillar-explore-cta__rule"></div>
</div>

{% stylesheet %}
  .pillar-explore-cta {
    background: #ffffff;
    padding: 3rem var(--page-margin, 16px) 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pillar-explore-cta__rule {
    width: 100%;
    max-width: var(--page-content-width, 1400px);
    border-top: 1px solid #000000;
    margin-top: 2.5rem;
  }

  .pillar-explore-cta__label {
    font-family: "optima-lt-pro", var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #000000;
    text-decoration: none;
  }

  .pillar-explore-cta__label:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Explore CTA",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Explore the Collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    { "name": "Explore CTA" }
  ]
}
{% endschema %}
